{
  "name": "Boş veya Bekliyor durumundaki FormID alanını doldur",
  "description": "B sütunu FormID, C sütunu durum. Tabloyu, ERP penceresini ve FormID hedefini seçin. İlk deneme 1 fiziksel satırla sınırlıdır. Yalnız alan doldurur; Enter, fatura kaydı veya Tamamlandı yazma işlemi içermez.",
  "department": "Genel",
  "steps": [
    {
      "id": "find-erp-window",
      "title": "ERP penceresini seç",
      "action": "desktop.find_window",
      "params": {
        "application": "",
        "title": "ERP_PENCERE_BASLIGINI_SECIN",
        "match": "exact",
        "timeout": 5,
        "on_missing": "stop",
        "output": "erp_window"
      }
    },
    {
      "id": "read-formid-and-status",
      "title": "FormID ve durum sütunlarını birlikte oku",
      "action": "sheets.read_rows",
      "params": {
        "spreadsheet_id": "GOOGLE_SHEETS_KIMLIGINI_DEGISTIRIN",
        "worksheet": "Sayfa1",
        "start_row": 2,
        "max_rows": 1,
        "columns": {"form_id": "B", "status": "C"},
        "key": "form_id",
        "empty_policy": "stop",
        "output": "sheet_rows"
      }
    },
    {
      "id": "each-formid-row",
      "title": "Her FormID satırı için",
      "action": "control.for_each",
      "params": {"items": "${sheet_rows}", "item_name": "row"},
      "children": [
        {
          "id": "only-blank-or-pending",
          "title": "Durum boş veya Bekliyor ise",
          "action": "control.if",
          "params": {
            "left": "${row.status}",
            "operator": "empty_or_eq",
            "right": "Bekliyor"
          },
          "children": [
            {
              "id": "fill-formid-field",
              "title": "FormID alanının hedefini seç",
              "action": "desktop.window_fill",
              "params": {
                "window": "${erp_window}",
                "target_mode": "coordinates",
                "x": null,
                "y": null,
                "text": "${row.form_id}",
                "clear": true
              }
            }
          ],
          "otherwise": []
        }
      ]
    }
  ]
}
