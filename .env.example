# Run the application from the project directory; copy to .env (never commit it).
RPA_DATA_DIR=./data
RPA_PORT=8765

# Use a separate server-side SELECT-only account. Leave empty for the demo.
# PostgreSQL: postgresql+psycopg://rpa_reader:PASSWORD@localhost:5432/erp
# SQL Server: mssql+pyodbc://rpa_reader:PASSWORD@localhost/erp?driver=ODBC+Driver+18+for+SQL+Server
RPA_DATABASE_URL=
# Fully qualified table names; application validates these names before querying.
RPA_ALLOWED_TABLES=public.IASSALITEM,public.IASINVITEM
RPA_MAX_ROWS=10000

# Path to your service account JSON, outside version control.
RPA_GOOGLE_CREDENTIALS_PATH=
RPA_TEMPLATE_DIR=./assets/templates
RPA_TESSERACT_CMD=
RPA_OCR_LANGUAGE=tur+eng
RPA_ACTION_TIMEOUT=30
